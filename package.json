{
  "name": "oss-report",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --parallel --stream dev",
    "dev:mastra": "pnpm --filter @oss-report/mastra dev",
    "dev:web": "pnpm --filter @oss-report/web dev",
    "build": "pnpm build:web && pnpm build:mastra",
    "build:mastra": "pnpm --filter @oss-report/mastra build",
    "build:web": "pnpm --filter @oss-report/web build",
    "deploy": "pnpm build:web && pnpm --filter @oss-report/mastra run deploy",
    "typecheck": "pnpm -r typecheck"
  },
  "dependencies": {
    "@chat-adapter/slack": "^4.36.0",
    "@mastra/core": "^1.63.1",
    "@mastra/duckdb": "^1.6.3",
    "@mastra/evals": "^1.9.0",
    "@mastra/libsql": "^1.22.1",
    "@mastra/loggers": "^1.3.0",
    "@mastra/memory": "^1.28.1",
    "@mastra/observability": "^1.17.4",
    "@mastra/pg": "^1.22.1",
    "discord.js": "^14.27.0",
    "octokit": "^5.0.5",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
